{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --force*)",
      "Bash(git config core.hooksPath*)",
      "Read(./data/**)",
      "Read(~/.secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-guard.sh\""
          }
        ]
      }
    ]
  }
}
